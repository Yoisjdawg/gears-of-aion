+    // Daevas of E-Day: without mappings the unversioned property block can't be sized, so try each
+    // position where it could end and keep the one where the object's own data reads to exactly validPos.
+    private static void DeserializeObjectWithoutMappings(UObject obj, FAssetArchive Ar, long serialOffset, long validPos)
+    {
+        if (Globals.MappinglessFilter is { } filter && !filter(obj)) { Ar.Position = validPos; return; }
+        if (Globals.MappinglessCustom is { } custom && custom(obj, Ar, serialOffset, validPos)) { Ar.Position = validPos; return; }
+        long start;
+        try
+        {
+            Globals.SkipPropertiesTo = -1;
+            var first = (FAssetArchive) Ar.Clone();
+            first.Position = serialOffset;
+            obj.Deserialize(first, validPos);
+            if (first.Position == validPos) { Ar.Position = validPos; return; }
+            start = validPos;
+        }
+        catch (NoMappingsException e) { start = e.HeaderEnd; }
+        catch { start = validPos; }
+
+        var isCdo = obj.Flags.HasFlag(EObjectFlags.RF_ClassDefaultObject);
+        var probe = (FAssetArchive) Ar.Clone();
+        for (var c = start; c <= validPos - (isCdo ? 0 : 4); c++)
+        {
+            if (!isCdo)
+            {
+                probe.Position = c;
+                var hasGuid = probe.Read<int>();
+                if (hasGuid is not (0 or 1)) continue;
+            }
+            if (Globals.MappinglessPrecheck is { } precheck)
+            {
+                probe.Position = c;
+                try { if (!precheck(obj, probe)) continue; } catch { continue; }
+            }
+            Globals.MappinglessReset?.Invoke(obj);
+            var attempt = (FAssetArchive) Ar.Clone();
+            bool accepted;
+            try
+            {
+                Globals.SkipPropertiesTo = c;
+                attempt.Position = serialOffset;
+                obj.Deserialize(attempt, validPos);
+                accepted = attempt.Position == validPos;
+                if (!accepted) Globals.LastMappinglessError = $"ended at {attempt.Position - validPos} from export end";
+            }
+            catch (Exception e)
+            {
+                Globals.LastMappinglessError = e.Message;
+                // The data we came for may already be read even if a game-specific tail is not understood.
+                accepted = Globals.MappinglessAcceptPartial?.Invoke(obj) == true;
+                if (Globals.MappinglessDebug && c - serialOffset < 400)
+                {
+                    probe.Position = c - 32;
+                    Console.WriteLine("    bytes@-32: " + Convert.ToHexString(probe.ReadBytes(200)));
+                }
+                if (Globals.MappinglessDebug)
+                    Console.WriteLine($"    cand {c - serialOffset}/{validPos - serialOffset}: {e.GetType().Name} {e.Message.Split('\n')[0]} at {attempt.Position - serialOffset} | {e.StackTrace?.Split('\n').FirstOrDefault()?.Trim()} partial={accepted}");
+            }
+            if (accepted)
+            {
+                probe.Position = c;
+                Globals.LastMappinglessBytes = probe.ReadBytes((int) Math.Min(48, validPos - c));
+                Ar.Position = validPos;
+                return;
+            }
+        }
+        Globals.MappinglessReset?.Invoke(obj);
+        Ar.Position = validPos;
+    }
