    "xp": "XP on kill",
    "size": "hit height in metres",
    "color": "effect colour (hex)",
    "flyHeight": "metres above the street it flies at (0 = walks); flyers come straight at you over the rooftops",
    "armour": "percent cut from physical damage",
    "weak": "element it takes 30% more from (none for no weakness)",
    "resist": "element it takes 30% less from (none for no resistance)",
    "special": "what else it does: none | heal (mends nearby Locust) | seed (launches Nemacysts) | snipe (aims a laser first) | grenade (lobs frags you can evade) | beam (sweeps a beam) | acid (spits poison) | boss (phases, telegraphed slams, an HP bar)",
    "title": "shown over a boss or elite (none for regular Locust)"
  },
