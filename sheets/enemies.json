    "character": "Gears model (characters.id)",
    "hp": "hit points",
    "damage": "per attack",
    "attackInterval": "seconds between attacks",
    "attackRange": "metres (melee if small)",
    "ranged": "fires a projectile instead of hitting",
    "projectileSpeed": "metres per second (0 for melee)",
    "splash": "metres of blast: ranged shots explode; a melee enemy with splash is a bomb that explodes on reaching you (and when it dies, hurting nearby Locust too)",
