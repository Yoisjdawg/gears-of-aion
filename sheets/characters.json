{
  "sheet": "characters",
  "about": "Gears of War: E-Day characters read from the player's install (skeletal meshes under FairlightConcept/Content/Fairlight/Characters/). Posed on their own Gears skeletons; cycles are baked at load.",
  "columns": {
    "id": "key",
    "name": "who it is in Gears",
    "parts": "skeletal meshes drawn together (paths under Characters/, no .uasset)",
    "lod": "which level of detail to read (0 = full)",
    "gait": "upright | hunched (how the walk cycle bends the body)",
    "stride": "walk cycle leg swing in degrees",
    "attackArm": "R or L: which arm the attack swings",
    "handBone": "bone the held gun attaches to (none = no gun)",
    "heldGun": "Gears gun this character carries (skeletal mesh path under Weapons/, none = no gun; the player carries their chosen Gears weapon)",
    "animSkeleton": "Gears skeleton the animations below were made for (path under Characters/)",
    "idleAnim": "standing loop (path under Animation/Gameplay/, none = procedural)",
    "walkAnim": "moving loop (path under Animation/Gameplay/, none = procedural)",
    "attackAnim": "attack (path under Animation/Gameplay/, none = procedural swing)",
    "spawnAnim": "emerging from an E-hole when it spawns (path under Animation/Gameplay/, none = rises out of a dust burst)",
    "deathAnim": "death (path under Animation/Gameplay/, none = procedural fall)",
    "evadeAnim": "evasion roll (path under Animation/Gameplay/, none = a lean)",
    "extraAnims": "more Gears animations as clip=path pairs separated by ';' (cast, hit, land, jump, sprint, strafeL, strafeR, idle2, victory, getup), or none"
  },
