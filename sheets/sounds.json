{
  "sheet": "sounds",
  "about": "Gears of War: E-Day sounds, played from the player's install: each row is a Wwise event (path under WwiseAudio/Events/Fairlight_Events/); its media are read and played as recorded.",
  "columns": {
    "id": "key",
    "event": "Wwise event (no .uasset)",
    "owner": "what makes the sound (weapons.id, enemies.id, or music | ambience | hero | ui | world)",
    "when": "fire | death | spawn | reload (reload starts) | reload-done (normal or good reload ends) | reload-perfect (perfect Active Reload) | reload-jam (missed Active Reload) | any other cue the game asks for (music: menu, siege, boss...; hero: step, swing, hit, evade, flap, levelup; world: ehole, thunder, fire, rain, explosion; ui: click, victory, defeat)",
    "pick": "shot (a full shot plus a low thump layer) | any (one recording at random)",
    "volume": "0-1",
    "maxLength": "seconds kept from each recording, with a short fade-out (0 = whole recording)"
  },
