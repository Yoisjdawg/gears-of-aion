    "mpPerLevel": "MP gained per level",
    "mpRegen": "MP per second",
    "moveSpeed": "metres per second",
    "skillPower": "multiplier on skill damage and healing",
    "gunPower": "multiplier on Gears weapon damage",
    "color": "class colour (hex) for UI and skill effects",
    "skills": "hotbar skills in slot order, 8 slots (skills.id)",
    "description": "class-select blurb",
    "basicKind": "basic attack (left mouse / RT): melee (a swing in front) | bolt (a magic bolt at the aim) | arrow (an arrow at the aim)",
